diff --git a/src/bench_smoothness.h b/src/bench_smoothness.h
new file mode 100644
index 000000000..fb24f4177
--- /dev/null
+++ b/src/bench_smoothness.h
@@ -0,0 +1,144 @@
+#pragma once
+/*
+	BENCH TEMP - frame pacing / smoothness audit.
+
+	Enabled with HYPERSOMNIA_SMOOTHNESS_BENCH=<output csv>.
+	Script (game thread, steady clock since the first editor frame):
+		3 s  -> start playtesting (like Space)
+		6 s  -> press A + W
+		10 s -> release A + W
+		10.5 s -> dump csv and quit
+*/
+
+#include <chrono>
+#include <vector>
+#include <mutex>
+#include <cstdio>
+#include <cstdlib>
+#include <csignal>
+#include <string>
+#include "augs/window_framework/event.h"
+
+namespace bench_smooth {
+	inline double now_s() {
+		using namespace std::chrono;
+		return duration<double>(steady_clock::now().time_since_epoch()).count();
+	}
+
+	struct record {
+		/* game thread */
+		double t_frame_start = 0;
+		double frame_delta = 0;
+		double t_prepared = 0;
+		double cam_x = 0, cam_y = 0, cam_raw_x = 0, cam_raw_y = 0, zoom = 0;
+		double char_x = 0, char_y = 0;
+		double interp_ratio = 0;
+		long long steps = 0;
+		int walking = 0;
+
+		/* render thread */
+		double t_perform_begin = 0;
+		double t_perform_end = 0;
+		double t_swap_begin = 0;
+		double t_swap_end = 0;
+		long long gl_now_at_perform_begin = 0;
+		long long gpu_begin = 0;
+		long long gpu_end = 0;
+	};
+
+	struct state {
+		bool enabled = false;
+		std::string out_path;
+
+		double t0 = -1;
+		int stage = 0;
+		bool walking = false;
+
+		std::mutex m;
+		std::vector<record> records;
+
+		state() {
+			if (const auto p = std::getenv("HYPERSOMNIA_SMOOTHNESS_BENCH")) {
+				enabled = true;
+				out_path = p;
+				records.reserve(200000);
+			}
+		}
+
+		void dump() {
+			auto lk = std::scoped_lock(m);
+
+			if (auto f = std::fopen(out_path.c_str(), "w")) {
+				std::fprintf(f, "t_frame_start,frame_delta,t_prepared,cam_x,cam_y,cam_raw_x,cam_raw_y,zoom,char_x,char_y,interp_ratio,steps,walking,t_perform_begin,t_perform_end,t_swap_begin,t_swap_end,gl_now_at_perform_begin,gpu_begin,gpu_end\n");
+
+				for (const auto& r : records) {
+					std::fprintf(
+						f,
+						"%.9f,%.9f,%.9f,%.4f,%.4f,%.4f,%.4f,%.6f,%.4f,%.4f,%.6f,%lld,%d,%.9f,%.9f,%.9f,%.9f,%lld,%lld,%lld\n",
+						r.t_frame_start, r.frame_delta, r.t_prepared,
+						r.cam_x, r.cam_y, r.cam_raw_x, r.cam_raw_y, r.zoom,
+						r.char_x, r.char_y, r.interp_ratio, r.steps, r.walking,
+						r.t_perform_begin, r.t_perform_end, r.t_swap_begin, r.t_swap_end,
+						r.gl_now_at_perform_begin, r.gpu_begin, r.gpu_end
+					);
+				}
+
+				std::fclose(f);
+			}
+		}
+
+		/*
+			Called every game frame with the frame's window entropy - injects the key events of the script.
+		*/
+		template <class StartPlaytest>
+		void script(augs::local_entropy& entropy, const bool in_editor, StartPlaytest&& start_playtest) {
+			if (!enabled || !in_editor) {
+				return;
+			}
+
+			const auto t = now_s();
+
+			if (t0 < 0) {
+				t0 = t;
+			}
+
+			const auto elapsed = t - t0;
+
+			auto key_event = [&](const augs::event::message msg, const augs::event::keys::key k) {
+				auto ch = augs::event::change();
+				ch.msg = msg;
+				ch.data.key.key = k;
+				entropy.push_back(ch);
+			};
+
+			using namespace augs::event;
+
+			if (stage == 0 && elapsed > 3.0) {
+				start_playtest();
+				stage = 1;
+			}
+			else if (stage == 1 && elapsed > 6.0) {
+				key_event(message::keydown, keys::key::A);
+				key_event(message::keydown, keys::key::W);
+				walking = true;
+				stage = 2;
+			}
+			else if (stage == 2 && elapsed > 10.0) {
+				key_event(message::keyup, keys::key::A);
+				key_event(message::keyup, keys::key::W);
+				walking = false;
+				stage = 3;
+			}
+			else if (stage == 3 && elapsed > 10.5) {
+				dump();
+				stage = 4;
+				std::raise(SIGTERM);
+			}
+		}
+	};
+
+	inline state& get() {
+		static state s;
+		return s;
+	}
+}
